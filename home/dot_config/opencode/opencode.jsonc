{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-wakelock",
    {
      "package": "opencode-tool-kagi",
      "options": {
        "websearch": true,
        "webfetch": true,
        "extract": true
      }
    }
  ],
  "mcp": {
    "servers": {
      "vroid": {
        "type": "remote",
        "url": "http://127.0.0.1:17891/mcp",
        "oauth": false
      },
      "blender": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-for-blender"
        ],
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        }
      }
    }
  }
}
